{
  "name": "test",
  "version": "0.1.0",
  "entrypoint": "test",
  "template": "rag",
  "dependencies": [
    "ollama",
    "psycopg2-binary"
  ],
  "config": {
    "device": "auto",
    "batch_size": 32,
    "rag": {
      "chat_provider": "ollama",
      "model_name": "qwen3:1.7b",
      "embedding_model": "nomic-embed-text",
      "vector_db": "memory",
      "embedding_engine": "tfidf",
      "enable_hyde": true,
      "enable_smart_chunker": true
    }
  },
  "paths": {
    "data": "data",
    "models": "models",
    "experiments": "experiments",
    "artifacts": "artifacts",
    "checkpoints": "checkpoints"
  }
}